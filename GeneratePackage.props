<Project>
    <PropertyGroup>
        <Authors>ClassPixelPro</Authors>
        <Company>ClassPixelPro</Company>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://class.imzcz.cn</PackageProjectUrl>
		<RepositoryUrl>https://class.imzcz.cn</RepositoryUrl>
	    <PackageReadmeFile>README.md</PackageReadmeFile>
		<Copyright>Copyright (c) 2024 ClassPixelPro</Copyright>
	    <RepositoryType>git</RepositoryType>
	</PropertyGroup>
    <ItemGroup>
	    <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
	

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<Deterministic>true</Deterministic>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>
</Project>