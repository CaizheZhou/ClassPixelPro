<controls:ComponentBase x:TypeArguments="componentSettings:ClockComponentSettings" 
                        x:Class="ClassPixelPro.Controls.Components.ClockComponent"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:local="clr-namespace:ClassPixelPro.Controls.Components"
                        xmlns:controls="clr-namespace:ClassPixelPro.Core.Abstractions.Controls;assembly=ClassPixelPro.Core"
                        xmlns:converters="clr-namespace:ClassPixelPro.Core.Converters;assembly=ClassPixelPro.Core"
                        xmlns:componentSettings="clr-namespace:ClassPixelPro.Models.ComponentSettings"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" d:DesignWidth="800">
    <!--
        时钟组件布局说明：
        使用 StackPanel 水平排列 HH + 冒号 + mm (+ 冒号 + ss)，
        冒号通过 Opacity 控制闪烁，秒部分通过 IsVisible 控制显示。
        这样无论冒号是否闪烁、是否显示秒，数字部分的布局始终一致，避免间距抖动。
    -->
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
          TextElement.FontSize="{DynamicResource MainWindowEmphasizedFontSize}"
          x:Name="Root"
          Classes.TimeSeparatorShowing="{Binding IsTimeSeparatorShowing}"
          Classes.ShowSeconds="{Binding Settings.ShowSeconds}"
          DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:ClockComponent}}">
        <Grid.Styles>
            <Style Selector="Grid#Root">
                <!-- 冒号默认透明（即隐藏），TimeSeparatorShowing 时显示 -->
                <Style Selector="^ TextBlock.separator">
                    <Setter Property="Opacity" Value="0" />
                </Style>
                <Style Selector="^.TimeSeparatorShowing TextBlock.separator">
                    <Setter Property="Opacity" Value="1" />
                </Style>
                <!-- 秒部分默认不可见，ShowSeconds 时显示 -->
                <Style Selector="^ TextBlock.seconds">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
                <Style Selector="^.ShowSeconds TextBlock.seconds">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
            </Style>
        </Grid.Styles>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:HH}}" />
            <TextBlock Classes="separator" Text=":" />
            <TextBlock Text="{Binding CurrentTime, StringFormat={}{0:mm}}" />
            <TextBlock Classes="separator seconds" Text=":" />
            <TextBlock Classes="seconds" Text="{Binding CurrentTime, StringFormat={}{0:ss}}" />
        </StackPanel>
    </Grid>
</controls:ComponentBase>
