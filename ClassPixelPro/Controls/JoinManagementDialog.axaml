<ci:MyWindow x:Class="ClassPixelPro.Controls.JoinManagementDialog"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClassPixelPro.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ci="http://classpixelpro.tech/schemas/xaml/core"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             SizeToContent="Height"
             Width="400"
             Title="加入管理"
             CanResize="False">
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:JoinManagementDialog}}">
        <StackPanel Margin="16" 
                    IsEnabled="{Binding ViewModel.IsWorking, Converter={StaticResource InvertBooleanConverter}}">
            <TextBlock Theme="{StaticResource SubtitleTextBlockStyle}">
                <Run Text="加入管理"/>
            </TextBlock>
            <TextBlock Margin="0 8 0 0" TextWrapping="Wrap">
                <Run Text="输入组织 ID 加入管理。组织 ID 为 5 位大写字母或数字，可向管理员获取。"></Run>
            </TextBlock>
            <ci:Field Label="组织 ID（必填）">
                <TextBox Text="{Binding ViewModel.OrgId}" />
            </ci:Field>
            <ci:Field Label="ID（可选）">
                <TextBox Text="{Binding ViewModel.ManagementSettings.ClassIdentity}" />
            </ci:Field>
            <TextBlock Margin="0 6 0 0" Text="{Binding ViewModel.ErrorMessage}"
                       IsVisible="{Binding ViewModel.IsErrorMessageOpen}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap"/>
            <ProgressBar HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         IsIndeterminate="True"
                         IsVisible="{Binding ViewModel.IsWorking}"
            />
            <Grid Margin="0 16 0 0" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="* *"  HorizontalAlignment="Stretch">
                    <Button Grid.Column="0" Content="取消" 
                            IsCancel="True"
                            HorizontalAlignment="Stretch"
                            Margin="0 0 2 0"
                            Command="{Binding Close}"/>
                    <Button Grid.Column="1" Content="连接" IsDefault="True" 
                            IsEnabled="{Binding ViewModel.CanJoin}"
                            Classes="accent"
                            HorizontalAlignment="Stretch"
                            Margin="2 0 0 0"
                            Click="ButtonOk_OnClick"/>
                </Grid>
            </Grid>
        </StackPanel>   
    </Grid>
</ci:MyWindow>
