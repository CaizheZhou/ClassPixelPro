<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ci="http://classpixelpro.tech/schemas/xaml/core"
        mc:Ignorable="d"
        d:DesignWidth="80" d:DesignHeight="40"
        x:Class="ClassPixelPro.Views.Controls.MonitorIndicator"
        Width="80" Height="40"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        PointerPressed="MonitorIndicator_OnPointerPressed"
        DoubleTapped="MonitorIndicator_OnDoubleTapped">
    <Border CornerRadius="20"
            Background="#CC1E1E1E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="10 6"
            BoxShadow="0 2 8 0 #66000000">
        <Grid ColumnDefinitions="Auto,Auto,Auto">
            <!-- 摄像头图标 -->
            <ci:FluentIcon Grid.Column="0"
                           Glyph="&#xE8B6;"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center" />
            <!-- 闪烁红点 -->
            <Ellipse Grid.Column="1"
                     Width="8" Height="8"
                     Margin="6 0 0 0"
                     VerticalAlignment="Center"
                     x:Name="BlinkingDot">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#FF3B30" />
                </Ellipse.Fill>
                <Ellipse.Styles>
                    <Style Selector="Ellipse">
                        <Style.Animations>
                            <Animation Duration="0:0:1" IterationCount="INFINITE">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1" />
                                </KeyFrame>
                                <KeyFrame Cue="50%">
                                    <Setter Property="Opacity" Value="1" />
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="0.3" />
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Ellipse.Styles>
            </Ellipse>
            <!-- "监控中"文本 -->
            <TextBlock Grid.Column="2"
                       Text="监控中"
                       Foreground="White"
                       FontSize="11"
                       Margin="6 0 0 0"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>