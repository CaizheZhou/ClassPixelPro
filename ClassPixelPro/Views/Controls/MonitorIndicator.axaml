<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ci="http://classpixelpro.tech/schemas/xaml/core"
        mc:Ignorable="d"
        d:DesignWidth="120" d:DesignHeight="32"
        x:Class="ClassPixelPro.Views.Controls.MonitorIndicator"
        Width="120" Height="32"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        PointerPressed="MonitorIndicator_OnPointerPressed"
        DoubleTapped="MonitorIndicator_OnDoubleTapped">
    <!-- 改进的 UI：圆角矩形 + 半透明背景 + 柔和脉冲红点 + 摄像头图标 + "监控中" 文字 -->
    <Border CornerRadius="8"
            Background="#CC1E1E1E"
            BorderBrush="#22FFFFFF"
            BorderThickness="1"
            Padding="10 4"
            Opacity="0.92"
            BoxShadow="0 2 6 0 #55000000">
        <Grid ColumnDefinitions="Auto,Auto,Auto"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">
            <!-- 摄像头图标：使用更精致的 video camera glyph -->
            <ci:FluentIcon Grid.Column="0"
                           Glyph="&#xE8B6;"
                           FontSize="14"
                           Foreground="#FFF5F5F5"
                           VerticalAlignment="Center" />
            <!-- 柔和脉冲红点：opacity 0.4 → 0.8，周期 1.5s -->
            <Ellipse Grid.Column="1"
                     Width="7" Height="7"
                     Margin="6 0 0 0"
                     VerticalAlignment="Center"
                     x:Name="BlinkingDot">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#FF4D4F" />
                </Ellipse.Fill>
                <Ellipse.Styles>
                    <Style Selector="Ellipse">
                        <Style.Animations>
                            <Animation Duration="0:0:1.5" IterationCount="INFINITE">
                                <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="0.4" />
                                </KeyFrame>
                                <KeyFrame Cue="50%">
                                    <Setter Property="Opacity" Value="0.8" />
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="0.4" />
                                </KeyFrame>
                            </Animation>
                        </Style.Animations>
                    </Style>
                </Ellipse.Styles>
            </Ellipse>
            <!-- "监控中" 文字标签：小字号 11px -->
            <TextBlock Grid.Column="2"
                       Text="监控中"
                       Foreground="#FFF5F5F5"
                       FontSize="11"
                       Margin="6 0 0 0"
                       VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>
