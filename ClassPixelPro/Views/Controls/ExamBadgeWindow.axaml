<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ci="http://classpixelpro.tech/schemas/xaml/core"
        mc:Ignorable="d"
        d:DesignWidth="220" d:DesignHeight="36"
        x:Class="ClassPixelPro.Views.Controls.ExamBadgeWindow"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="WidthAndHeight">
    <!-- 考试中角标：置于屏幕顶部中央（岛栏下方），考试期间常驻提示 -->
    <Border CornerRadius="8"
            Background="#CC4A148C"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="12 6"
            Opacity="0.94"
            BoxShadow="0 2 8 0 #66000000">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ci:FluentIcon Glyph="&#xE945;" FontSize="14" VerticalAlignment="Center" Foreground="#FFCE93D8"/>
            <TextBlock x:Name="ExamText"
                       Text="考试中"
                       Foreground="White"
                       FontWeight="SemiBold"
                       FontSize="14"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
