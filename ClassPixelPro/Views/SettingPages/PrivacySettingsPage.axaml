<controls:SettingsPageBase x:Class="ClassPixelPro.Views.SettingPages.PrivacySettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassPixelPro.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassPixelPro.Core.Abstractions.Controls;assembly=ClassPixelPro.Core"
      xmlns:controls1="clr-namespace:ClassPixelPro.Core.Controls;assembly=ClassPixelPro.Core"
      xmlns:controls2="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:PrivacySettingsPage}"
      Loaded="PrivacySettingsPage_OnLoaded"
      Unloaded="PrivacySettingsPage_OnUnloaded">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Tag="CanPolicyDisable">
            <StackPanel Margin="0 0 0 16">
                <TextBlock Text="匿名使用情况分析"
                           Theme="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Margin="0 6 0 0" TextWrapping="Wrap"
                           Text="本应用会将应用版本、运行系统、启动与活跃情况以及崩溃信息匿名上报到 ClassPixelPro 的自建统计服务，以改进本应用。上报内容不包含您的个人信息，您也可以随时在此页面关闭。" />
                <TextBlock Margin="0 6 0 0" TextWrapping="Wrap">
                    <Run Text="更多信息请见">
                    </Run>
                    <HyperlinkButton Click="HyperlinkMsAppCenter_OnClick">
                        《ClassPixelPro 隐私政策》
                    </HyperlinkButton>
                    。
                </TextBlock>
            </StackPanel>
            
            <controls2:SettingsExpander IconSource="{controls1:FluentIconSource &#xE4E8;}"
                                        Header="启用匿名使用情况分析"
                                        Description="启用后，应用将收集使用情况与错误信息并上报，以改进此应用。上报的信息不包含您的个人信息，仅使用随机生成的匿名标识。关闭后应用将不再上报任何数据。">
                <controls2:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding SettingsService.Settings.IsSentryEnabled, Mode=TwoWay}"/>
                </controls2:SettingsExpander.Footer>
            </controls2:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
