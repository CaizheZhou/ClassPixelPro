<controls:SettingsPageBase x:Class="ClassPixelPro.Views.SettingPages.FaceAttendanceSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassPixelPro.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassPixelPro.Core.Abstractions.Controls;assembly=ClassPixelPro.Core"
      xmlns:controls1="clr-namespace:ClassPixelPro.Core.Controls;assembly=ClassPixelPro.Core"
      xmlns:ci="http://classpixelpro.tech/schemas/xaml/core"
      xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      mc:Ignorable="d"
      Design.Width="960" Design.Height="500"
      d:DataContext="{d:DesignInstance local:FaceAttendanceSettingsPage}"
      Loaded="FaceAttendanceSettingsPage_OnLoaded"
      Unloaded="FaceAttendanceSettingsPage_OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <controls1:IconText Glyph="&#xE4E8;" Text="人脸考勤" Margin="0 0 0 4" />

            <!-- 前置条件横幅：未加入集控或未绑定班主任时显示 -->
            <Border IsVisible="{Binding ViewModel.PrerequisiteMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource InfoBarWarningSeverityBrush}"
                    Padding="16 12"
                    CornerRadius="8"
                    Margin="0 0 0 8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ci:FluentIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ViewModel.PrerequisiteMessage}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 功能说明横幅（前置条件满足时显示） -->
            <Border IsVisible="{Binding ViewModel.PrerequisiteMessage, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Padding="16 12"
                    CornerRadius="8"
                    Margin="0 0 0 8">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ci:FluentIcon Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="人脸考勤到设定时间自动抓拍一轮，比对本机人脸库得出迟到名单。"
                                   TextWrapping="Wrap" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="人脸特征只保存在本机，上报集控的只有姓名与统计数字。抓拍时间由组织统一下发，本地不能修改。"
                               TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="20 0 0 0" />
                </StackPanel>
            </Border>

            <!-- 功能总开关 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE4E8;}"
                                        Header="启用人脸考勤"
                                        Description="开启后按组织下发的抓拍时间自动执行考勤；结果供班主任端查看。"
                                        IsExpanded="True">
                <controls3:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.FaceSettings.IsEnabled, Mode=TwoWay}"
                                  IsCheckedChanged="ToggleEnabled_OnIsCheckedChanged"
                                  IsEnabled="{Binding ViewModel.CanToggleEnabled}" />
                </controls3:SettingsExpander.Footer>
                <controls3:SettingsExpanderItem Content="立即执行一次"
                                                Description="手动触发一轮完整考勤，不受时间计划限制。"
                                                IsClickEnabled="True"
                                                Click="ButtonRunOnce_OnClick" />
            </controls3:SettingsExpander>

            <!-- 模型下载进度条：首次启用或手动「载入模型」时显示 -->
            <Border IsVisible="{Binding ViewModel.ModelDownloadVisible}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16 12" Margin="0 0 0 8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ci:FluentIcon Glyph="&#xE896;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ViewModel.ModelDownloadStage}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding ViewModel.ModelDownloadPercent}"
                                 Height="6" />
                </StackPanel>
            </Border>

            <!-- ============ 以下配置区块仅在「已加入集控且已绑定班主任」时显示（与远程监控同门禁） ============ -->
            <StackPanel IsVisible="{Binding ViewModel.PrerequisitesMet}">

            <!-- 运行状态 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE7B3;}"
                                        Header="运行状态"
                                        IsExpanded="True"
                                        IsVisible="{Binding ViewModel.FaceSettings.IsEnabled}">
                <controls3:SettingsExpanderItem Content="当前状态">
                    <controls3:SettingsExpanderItem.Footer>
                        <TextBlock Text="{Binding ViewModel.StatusText}" VerticalAlignment="Center" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="阶段"
                                                IsVisible="{Binding ViewModel.ProgressVisible}">
                    <controls3:SettingsExpanderItem.Footer>
                        <TextBlock Text="{Binding ViewModel.StageText}" VerticalAlignment="Center" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="进度"
                                                IsVisible="{Binding ViewModel.ProgressVisible}">
                    <controls3:SettingsExpanderItem.Footer>
                        <ProgressBar Width="160" Height="6" Minimum="0" Maximum="100"
                                     Value="{Binding ViewModel.ProgressPercent}" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="最近一次结果">
                    <controls3:SettingsExpanderItem.Footer>
                        <TextBlock Text="{Binding ViewModel.LastResultSummary}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            <!-- 抓拍时间计划：只读，组织统一下发 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE787;}"
                                        Header="抓拍时间"
                                        Description="由组织在集控后台统一设置，每 60 秒同步一次，本地不可修改。"
                                        IsExpanded="True">
                <controls3:SettingsExpanderItem Content="当前计划">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ViewModel.PlanDescription}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                                       IsVisible="{Binding !!ViewModel.PlanDescription.Length}" />
                            <TextBlock Text="组织尚未下发考勤时间" VerticalAlignment="Center" Opacity="0.6"
                                       IsVisible="{Binding !ViewModel.PlanDescription.Length}" />
                            <Button Theme="{StaticResource TransparentButton}"
                                    Content="{ci:FluentIcon &#xE72C;}"
                                    ToolTip.Tip="立即同步一次计划"
                                    Click="ButtonRefreshPlan_OnClick"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            <!-- 抓拍与判定参数 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE713;}"
                                        Header="抓拍与判定参数"
                                        Description="默认值已按 1280×720、多帧投票 2/4 调好；不确定就先别动。">
                <controls3:SettingsExpanderItem Content="判定方式"
                                                Description="{Binding ViewModel.JudgeModeHint}">
                    <controls3:SettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding ViewModel.JudgeModeOptions}"
                                  SelectedItem="{Binding ViewModel.SelectedJudgeMode, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  MinWidth="200" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="抓拍分辨率"
                                                Description="后排同学认不出来多半是分辨率不够；调高会更慢。">
                    <controls3:SettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding ViewModel.ResolutionOptions}"
                                  SelectedItem="{Binding ViewModel.SelectedResolution, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Description}"
                                  MinWidth="260" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="抓拍张数"
                                                Description="一轮连拍几张。人多的班建议 4 张以上。">
                    <controls3:SettingsExpanderItem.Footer>
                        <NumericUpDown MinWidth="120" Minimum="1" Maximum="20"
                                       FormatString="0"
                                       Value="{Binding ViewModel.CaptureCount, Mode=TwoWay}" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="抓拍间隔"
                                                Description="两张之间的毫秒数。太大同学会走开，太小画面几乎一样。">
                    <controls3:SettingsExpanderItem.Footer>
                        <NumericUpDown MinWidth="120" Minimum="0" Maximum="5000" Increment="100"
                                       FormatString="0"
                                       Value="{Binding ViewModel.CaptureIntervalMs, Mode=TwoWay}" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="最少命中张数"
                                                Description="多帧投票：同一个同学至少在几张照片里被认出来才算到。调高更不容易误判。">
                    <controls3:SettingsExpanderItem.Footer>
                        <NumericUpDown MinWidth="120" Minimum="1" Maximum="20"
                                       FormatString="0"
                                       Value="{Binding ViewModel.MinHits, Mode=TwoWay}" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="抓拍前预热"
                                                Description="摄像头从休眠唤醒需要时间，预热期间不取帧。">
                    <controls3:SettingsExpanderItem.Footer>
                        <NumericUpDown MinWidth="120" Minimum="0" Maximum="10"
                                       FormatString="0"
                                       Value="{Binding ViewModel.WarmUpSeconds, Mode=TwoWay}" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="保留抓拍照片"
                                                Description="保留后可回看当时的画面，便于核对漏判。照片只存在本机。">
                    <controls3:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.SaveSnapshots, Mode=TwoWay}" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="照片保留天数"
                                                IsVisible="{Binding ViewModel.SaveSnapshots}">
                    <controls3:SettingsExpanderItem.Footer>
                        <NumericUpDown MinWidth="120" Minimum="1" Maximum="365"
                                       FormatString="0"
                                       Value="{Binding ViewModel.RetentionDays, Mode=TwoWay}" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            <!-- 识别模型 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE945;}"
                                        Header="识别模型"
                                        Description="SFace 随应用包发布，纯 CPU 推理，8 GB 内存即可运行；ArcFace 更准，需单独下载或从 U 盘导入。"
                                        IsExpanded="True">
                <controls3:SettingsExpanderItem Content="模型状态">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ViewModel.ModelStatus}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ViewModel.RecognizerDisplay}" VerticalAlignment="Center"
                                       Opacity="0.6" IsVisible="{Binding ViewModel.ModelReady}" />
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="选用模型"
                                                Description="换模型后要重新点「载入模型」，并重新录入人脸（不同模型的特征不能混用）。">
                    <controls3:SettingsExpanderItem.Footer>
                        <ComboBox ItemsSource="{Binding ViewModel.RecognizerModels}"
                                  SelectedItem="{Binding ViewModel.SelectedRecognizerModel, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}"
                                  MinWidth="240" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="当前阈值"
                                                Description="相似度高于它才算同一个人。阈值按模型分别保存，切换模型不会串值。"
                                                IsVisible="{Binding ViewModel.ModelReady}">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ViewModel.EffectiveThreshold, StringFormat={}{0:F3}}"
                                       VerticalAlignment="Center" FontFamily="Consolas" />
                            <TextBlock Text="{Binding ViewModel.ThresholdNote}"
                                       VerticalAlignment="Center" Opacity="0.6" FontSize="12"
                                       MaxWidth="240" TextWrapping="Wrap" />
                            <NumericUpDown MinWidth="120" Minimum="0.05" Maximum="0.99" Increment="0.005"
                                           FormatString="0.000"
                                           Value="{Binding ViewModel.Threshold, Mode=TwoWay}" />
                            <Button Content="恢复推荐值"
                                    IsVisible="{Binding ViewModel.IsThresholdCustomized}"
                                    Command="{Binding ViewModel.ResetThresholdCommand}" />
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="载入模型"
                                                Description="首次使用或更换模型后点此载入，约需几秒。"
                                                IsClickEnabled="True"
                                                Click="ButtonLoadModels_OnClick" />
                <controls3:SettingsExpanderItem Content="模型自检"
                                                Description="真跑一次推理，把「文件都在但跑不起来」暴露出来。">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ViewModel.SelfTestResult}" VerticalAlignment="Center"
                                       MaxWidth="320" TextWrapping="Wrap" />
                            <Button Content="开始自检"
                                    Command="{Binding ViewModel.SelfTestCommand}" />
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="从文件导入模型"
                                                Description="学校网络连不上模型站时，用 U 盘把 .onnx 拷过来导入。"
                                                IsClickEnabled="True"
                                                Click="ButtonImportModel_OnClick" />
            </controls3:SettingsExpander>

            <!-- 摄像头 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE8B6;}"
                                        Header="摄像头"
                                        Description="考勤抓拍与远程监控、录制计划共用同一路摄像头；被占用时本轮自动跳过。"
                                        IsExpanded="True"
                                        IsVisible="{Binding ViewModel.CameraSupported}">
                <controls3:SettingsExpanderItem Content="使用摄像头"
                                                Description="多路摄像头时选对着教室的那一路；这里改了，远程监控也跟着用这一路。">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox ItemsSource="{Binding ViewModel.AvailableCameras}"
                                      SelectedItem="{Binding ViewModel.SelectedCamera, Mode=TwoWay}"
                                      DisplayMemberBinding="{Binding Name}"
                                      MinWidth="200" />
                            <Button Content="{ci:FluentIcon &#xE72C;}"
                                    ToolTip.Tip="重新读取摄像头列表"
                                    Command="{Binding ViewModel.RefreshCamerasCommand}" />
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="摄像头自检"
                                                Description="抓一帧并报告分辨率，用于确认摄像头可用、镜头对着人。"
                                                IsClickEnabled="True"
                                                Click="ButtonTestCamera_OnClick" />
                <controls3:SettingsExpanderItem Content="自检画面"
                                                IsClickEnabled="False"
                                                IsVisible="{Binding ViewModel.CameraPreview, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Border CornerRadius="6" Padding="4" Margin="0 8 0 0"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Image Source="{Binding ViewModel.CameraPreview}" Stretch="Uniform"
                               MaxHeight="220" HorizontalAlignment="Left" />
                    </Border>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            <!-- 花名册 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE8BD;}"
                                        Header="花名册"
                                        Description="已录入人脸的同学才会参与考勤判定；请假的同学不计迟到。"
                                        IsExpanded="True">
                <controls3:SettingsExpanderItem Content="已录入人数">
                    <controls3:SettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding ViewModel.RosterCount}" />
                            <Run Text=" 人 / " />
                            <Run Text="{Binding ViewModel.SampleCount}" />
                            <Run Text=" 条样本" />
                        </TextBlock>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="添加同学"
                                                Description="先加到花名册，再用摄像头或照片录入人脸。">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 8 0 0">
                        <TextBox x:Name="AddNameBox" MinWidth="180" Watermark="姓名" />
                        <Button Content="添加到花名册" Classes="accent"
                                Command="{Binding ViewModel.AddStudentCommand}"
                                CommandParameter="{Binding #AddNameBox.Text}" />
                    </StackPanel>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="批量导入名单"
                                                Description="从 Excel / 班级名单里复制，每行一位同学，支持「姓名」或「姓名,班级」。">
                    <StackPanel Spacing="8" Margin="0 8 0 0">
                        <TextBox Text="{Binding ViewModel.RosterImportText, Mode=TwoWay}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                 Watermark="张三&#10;李四,高一(3)班&#10;王五 高一(3)班" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox MinWidth="180" Watermark="默认班级（可留空）"
                                     Text="{Binding ViewModel.DefaultClassName, Mode=TwoWay}" />
                            <Button Content="导入名单" Classes="accent"
                                    Command="{Binding ViewModel.ImportRosterFromTextCommand}" />
                            <Button Content="从剪贴板粘贴"
                                    Command="{Binding ViewModel.ImportRosterFromClipboardCommand}" />
                            <Button Content="导出 CSV"
                                    Command="{Binding ViewModel.ExportRosterCsvCommand}" />
                            <Button Content="打开样本目录"
                                    Command="{Binding ViewModel.OpenFacesFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="远程录入"
                                                Description="拉取班主任端上传的照片并导入。班主任上传时填的姓名会自动匹配花名册。"
                                                IsClickEnabled="True"
                                                Click="ButtonRemoteEnroll_OnClick" />

                <!-- 学生列表：点一行选中，右侧开关控制参与考勤 / 今日请假 -->
                <controls3:SettingsExpanderItem Content="同学列表"
                                                IsClickEnabled="False"
                                                IsVisible="{Binding !!ViewModel.Students.Count}">
                    <controls3:SettingsExpanderItem.Footer>
                        <Button Theme="{StaticResource TransparentButton}"
                                Content="{ci:FluentIcon &#xE72C;}"
                                ToolTip.Tip="刷新花名册"
                                Click="ButtonRefreshRoster_OnClick"
                                VerticalAlignment="Center" />
                    </controls3:SettingsExpanderItem.Footer>
                    <ListBox ItemsSource="{Binding ViewModel.Students}"
                             SelectedItem="{Binding ViewModel.SelectedStudent, Mode=TwoWay}"
                             Background="Transparent" MaxHeight="300" Margin="0 8 0 0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="0 2">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="12" Opacity="0.6">
                                            <Run Text="{Binding ClassName}" />
                                            <Run Text="　" />
                                            <Run Text="{Binding FaceCount, StringFormat={}{0} 条样本}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center">
                                        <ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      OnContent="参与" OffContent="不参与"
                                                      IsCheckedChanged="StudentFlag_OnChanged" />
                                        <ToggleSwitch IsChecked="{Binding OnLeave, Mode=TwoWay}"
                                                      OnContent="请假" OffContent="在校"
                                                      IsCheckedChanged="StudentFlag_OnChanged" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </controls3:SettingsExpanderItem>

                <!-- 选中同学的操作与样本 -->
                <controls3:SettingsExpanderItem Content="选中同学"
                                                IsClickEnabled="False"
                                                IsVisible="{Binding ViewModel.SelectedStudent, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="10" Margin="0 8 0 0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="用摄像头录入"
                                    Command="{Binding ViewModel.EnrollFromCameraCommand}"
                                    CommandParameter="{Binding ViewModel.SelectedStudent}" />
                            <Button Content="从照片导入"
                                    Command="{Binding ViewModel.ImportFromFilesCommand}" />
                            <Button Content="从样本目录导入"
                                    Command="{Binding ViewModel.ImportFromFacesFolderCommand}" />
                            <Button Content="清空样本"
                                    Command="{Binding ViewModel.ClearStudentFacesCommand}"
                                    CommandParameter="{Binding ViewModel.SelectedStudent}" />
                            <Button Content="删除该同学"
                                    Command="{Binding ViewModel.RemoveStudentCommand}"
                                    CommandParameter="{Binding ViewModel.SelectedStudent}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="RenameBox" MinWidth="180" Watermark="新姓名" />
                            <Button Content="改名"
                                    Command="{Binding ViewModel.RenameSelectedCommand}"
                                    CommandParameter="{Binding #RenameBox.Text}" />
                            <TextBlock Text="「从照片导入」按文件名自动匹配同学；照片里有多张脸时会弹窗让你选。"
                                       VerticalAlignment="Center" FontSize="12" Opacity="0.6"
                                       TextWrapping="Wrap" MaxWidth="360" />
                        </StackPanel>

                        <TextBlock Text="人脸样本（删掉录错的那条）" FontWeight="SemiBold" FontSize="12"
                                   IsVisible="{Binding !!ViewModel.SelectedStudentSamples.Count}" />
                        <ItemsControl ItemsSource="{Binding ViewModel.SelectedStudentSamples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0 2">
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayText}"
                                                   VerticalAlignment="Center" FontSize="12" />
                                        <Button Grid.Column="1" Theme="{StaticResource TransparentButton}"
                                                Content="{ci:FluentIcon &#xE74D;}"
                                                ToolTip.Tip="删除这条样本"
                                                Command="{Binding $parent[ItemsControl].DataContext.ViewModel.RemoveFaceSampleCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            </StackPanel>
            <!-- ============ 门禁包裹结束 ============ -->

            <!-- 操作结果 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4" Padding="12" Margin="0,8,0,0"
                    IsVisible="{Binding !!ViewModel.ActionMessage.Length}">
                <TextBlock Text="{Binding ViewModel.ActionMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- 隐私说明 -->
            <TextBlock Margin="0 12 0 0" TextWrapping="Wrap" FontSize="12" Opacity="0.7"
                       Text="人脸特征向量与人脸小图只保存在本机；上送到集控与班主任端的仅有姓名、班级与统计数字，链路上不出现任何生物识别信息。抓拍照片按「保留天数」自动清理。" />
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
