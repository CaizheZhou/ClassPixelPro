<ci:SettingsPageBase x:Class="ClassPixelPro.Views.SettingPages.ManagementSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassPixelPro.Views.SettingPages"
      xmlns:ci="http://classpixelpro.tech/schemas/xaml/core"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:classPixelPro="clr-namespace:ClassPixelPro"
      xmlns:controls="clr-namespace:ClassPixelPro.Controls"
      xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance local:ManagementSettingsPage}"
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="ManagementSettingsPage_OnLoaded"
      Unloaded="ManagementSettingsPage_OnUnloaded">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <StackPanel Classes="cardContainer">
                <controls1:SettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="集控" FontWeight="Bold"/>

                        <StackPanel>
                            <TextBlock  TextWrapping="Wrap">
                                <Run>学校/组织的 IT 可以通过集控功能向学校内的 ClassPixelPro 实例统一分发课表、时间表和科目等信息，并且可以集中调整软件设置和限制部分功能的使用，提高管理的便利性。</Run>
                            </TextBlock>
                            <TextBlock  TextWrapping="Wrap" Margin="0 6 0 0" IsVisible="{Binding ManagementService.IsManagementEnabled}">
                                <Run>您目前正在受</Run>
                                <Run Text="{Binding ManagementService.Manifest.OrganizationName}"/>
                                <Run>的管理。</Run>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </controls1:SettingsExpanderItem>
                <controls1:SettingsExpanderItem Click="ButtonJoinManagement_OnClick" 
                                                IsClickEnabled="True"
                                                IsVisible="{Binding !ManagementService.IsManagementEnabled}">
                    <Grid>
                        <TextBlock Text="加入管理" />
                    </Grid>
                </controls1:SettingsExpanderItem>
                <controls1:SettingsExpanderItem Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                                IsClickEnabled="True"
                                                ActionIconSource="{ci:FluentIconSource &#xEC2E;}"
                                                CommandParameter="https://class.imzcz.cn/#/docs/management">
                    <Grid>
                        <TextBlock Text="了解更多" />
                    </Grid>
                </controls1:SettingsExpanderItem>
            </StackPanel>

            <StackPanel Classes="cardContainer"
                        IsVisible="{Binding !ManagementService.IsManagementEnabled}">
                <controls1:SettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="管理" FontWeight="Bold"/>

                        <StackPanel>
                            <TextBlock  TextWrapping="Wrap">
                                <Run>您可以在不启用云端集控的情况下调整应用的一些策略。</Run>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </controls1:SettingsExpanderItem>
                <controls1:SettingsExpanderItem Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                                IsClickEnabled="True"
                                                CommandParameter="classpixelpro://app/settings/management.credentials?ci_keepHistory=true">
                    <Grid>
                        <TextBlock Text="密码保护设置…" />
                    </Grid>
                </controls1:SettingsExpanderItem>
                <controls1:SettingsExpanderItem Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                                IsClickEnabled="True"
                                                CommandParameter="classpixelpro://app/settings/management.policy?ci_keepHistory=true">
                    <Grid>
                        <TextBlock Text="限制策略…" />
                    </Grid>
                </controls1:SettingsExpanderItem>
            </StackPanel>

            <StackPanel Classes="cardContainer">
                <controls1:SettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="客户端信息" FontWeight="Bold"/>
                    </StackPanel>
                </controls1:SettingsExpanderItem>
                <controls1:SettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap">
                            <Run>CUID：</Run><Run Text="{Binding ManagementService.Persist.ClientUniqueId}" />
                        </TextBlock>
                        <Button Content="复制 CUID" Click="ButtonCopyCuid_OnClick"
                                HorizontalAlignment="Left" Padding="12 4" />
                    </StackPanel>
                </controls1:SettingsExpanderItem>
                <controls1:SettingsExpanderItem
                    IsVisible="{Binding ManagementService.IsManagementEnabled}">
                    <TextBlock TextWrapping="Wrap">
                        <Run>ID：</Run><Run Text="{Binding ManagementService.Settings.ClassIdentity}" />
                    </TextBlock>
                </controls1:SettingsExpanderItem>
            </StackPanel>

            <StackPanel Classes="cardContainer"
                        IsVisible="{Binding ManagementService.IsManagementEnabled}">
                <controls1:SettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="服务端信息" FontWeight="Bold"/>
                    </StackPanel>
                </controls1:SettingsExpanderItem>
                <controls1:SettingsExpanderItem>
                    <TextBlock TextWrapping="Wrap">
                        <Run>服务端类型：</Run><Run Text="{Binding ManagementService.Manifest.ServerKind}"/>
                    </TextBlock>
                </controls1:SettingsExpanderItem>
            </StackPanel>

            <!-- 集控策略同步：可选择拉取特定配置 -->
            <StackPanel Classes="cardContainer"
                        IsVisible="{Binding ManagementService.IsManagementEnabled}">
                <controls1:SettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="集控策略同步" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7">
                            <Run>从服务器强制拉取选定的集控内容并覆盖本地设置。如果服务器同时下发了全局课表和本设备的专属课表，将优先使用专属课表。</Run>
                        </TextBlock>
                        <StackPanel Spacing="4" Margin="0 4 0 0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="PullClassPlanCheckBox"
                                          Content="课表（ClassPlan + ClassPlanGroups）"
                                          IsChecked="True"/>
                                <Button Content="👁 预览"
                                        Click="ButtonPreviewClassPlan_OnClick"
                                        Padding="8 2" FontSize="12"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="PullTimeLayoutCheckBox"
                                          Content="时间表（TimeLayouts）"
                                          IsChecked="True"/>
                                <Button Content="👁 预览"
                                        Click="ButtonPreviewTimeLayout_OnClick"
                                        Padding="8 2" FontSize="12"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="PullSubjectsCheckBox"
                                          Content="科目（Subjects）"
                                          IsChecked="True"/>
                                <Button Content="👁 预览"
                                        Click="ButtonPreviewSubjects_OnClick"
                                        Padding="8 2" FontSize="12"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="PullAppSettingsCheckBox"
                                          Content="应用设置（AppSettings）"
                                          IsChecked="True"/>
                                <Button Content="👁 预览"
                                        Click="ButtonPreviewAppSettings_OnClick"
                                        Padding="8 2" FontSize="12"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="PullComponentSchemeCheckBox"
                                          Content="组件方案（ComponentScheme）"
                                          IsChecked="True"/>
                                <Button Content="👁 预览"
                                        Click="ButtonPreviewComponentScheme_OnClick"
                                        Padding="8 2" FontSize="12"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="PullThemeCheckBox"
                                      Content="主题（Theme）"
                                      IsChecked="True"/>
                            <CheckBox x:Name="PullTempClassPlanCheckBox"
                                      Content="临时调课（TempClassPlan）"
                                      IsChecked="True"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0">
                            <Button Content="拉取选中并覆盖"
                                    Click="ButtonPullSelected_OnClick"
                                    Classes="accent"
                                    HorizontalAlignment="Left"
                                    Padding="16 6"/>
                            <Button Content="全部拉取并覆盖"
                                    Click="ButtonPullAll_OnClick"
                                    HorizontalAlignment="Left"
                                    Padding="16 6"/>
                        </StackPanel>
                    </StackPanel>
                </controls1:SettingsExpanderItem>
            </StackPanel>

            <StackPanel Classes="cardContainer"
                        IsVisible="{Binding ManagementService.IsManagementEnabled}">
                <controls1:SettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="教师绑定" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7">
                            <Run>将本设备绑定到班主任账户，绑定后班主任可在微信端查看本设备的课表信息。</Run>
                        </TextBlock>
                    </StackPanel>
                </controls1:SettingsExpanderItem>

                <!-- 已绑定教师状态 -->
                <controls1:SettingsExpanderItem IsVisible="{Binding ViewModel.IsTeacherBound}">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap">
                            <Run>已绑定教师：</Run>
                            <Run Text="{Binding ViewModel.BoundTeacherName}" FontWeight="Bold"/>
                        </TextBlock>
                        <Button Content="解绑" Click="ButtonUnbindTeacher_OnClick"
                                HorizontalAlignment="Left" Padding="12 4" />

                        <!-- 班主任控制台二维码：教师扫码进入教师端 -->
                        <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0 8 0 0">
                            <TextBlock Text="扫码进入教师控制台" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <Image Source="/Assets/TeacherConsoleQrCode.png"
                                   Width="220" Height="220" Stretch="Uniform"
                                   HorizontalAlignment="Center" />
                            <TextBlock Text="班主任可用微信扫码进入教师端管理界面"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="280" Opacity="0.7" />
                        </StackPanel>
                    </StackPanel>
                </controls1:SettingsExpanderItem>

                <!-- 未绑定时：显示绑定二维码区域 -->
                <controls1:SettingsExpanderItem IsVisible="{Binding !ViewModel.IsTeacherBound}">
                    <StackPanel Spacing="12">
                        <!-- 二维码显示区域 -->
                        <StackPanel IsVisible="{Binding ViewModel.BindingQrCodePath, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    HorizontalAlignment="Center" Spacing="8">
                            <Path Data="{Binding ViewModel.BindingQrCodePath}"
                                  Fill="Black"
                                  Width="220" Height="220"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"/>
                            <TextBlock Text="请班主任用微信扫描此二维码绑定设备"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" MaxWidth="280" Opacity="0.7"/>
                            <TextBlock Text="等待绑定中…" 
                                       IsVisible="{Binding ViewModel.IsPollingBindingStatus}"
                                       HorizontalAlignment="Center" Opacity="0.6"/>
                        </StackPanel>

                        <!-- 加载中 -->
                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding ViewModel.IsBindingQrLoading}"
                                     HorizontalAlignment="Stretch" Width="220"/>

                        <!-- 错误信息 -->
                        <TextBlock Text="{Binding ViewModel.BindingErrorMessage}"
                                   IsVisible="{Binding ViewModel.IsBindingErrorVisible}"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap" MaxWidth="280"
                                   HorizontalAlignment="Center"/>

                        <!-- 生成/刷新二维码按钮 -->
                        <Button Content="生成绑定二维码" 
                                Click="ButtonGenerateBindingQr_OnClick"
                                IsEnabled="{Binding !ViewModel.IsBindingQrLoading}"
                                HorizontalAlignment="Center" Padding="16 6"
                                Classes="accent"/>
                    </StackPanel>
                </controls1:SettingsExpanderItem>
            </StackPanel>

            <!-- 调课日志区域：仅在集控启用时显示 -->
            <StackPanel Classes="cardContainer"
                        IsVisible="{Binding ManagementService.IsManagementEnabled}">
                <controls1:SettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="调课日志" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7">
                            <Run>显示班主任通过集控后端对本设备课表进行的调课操作历史（最近 100 条）。</Run>
                        </TextBlock>
                    </StackPanel>
                </controls1:SettingsExpanderItem>
                <controls1:SettingsExpanderItem>
                    <StackPanel Orientation="Vertical" Spacing="8">
                        <!-- 空状态提示 -->
                        <TextBlock Text="暂无调课日志"
                                   Opacity="0.6"
                                   IsVisible="{Binding !ViewModel.ManagementLogs.Count}"/>
                        <!-- 日志列表 -->
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ViewModel.ManagementLogs}"
                                          IsVisible="{Binding !!ViewModel.ManagementLogs.Count}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0 0 0 4" Padding="10 6" CornerRadius="4"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Vertical" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="12" />
                                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" />
                                                    <TextBlock Text="✓" Foreground="Green"
                                                               IsVisible="{Binding Success}" />
                                                    <TextBlock Text="✗" Foreground="Red"
                                                               IsVisible="{Binding !Success}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" MaxWidth="500" />
                                                    <TextBlock Text="{Binding ErrorMessage}"
                                                               Foreground="Red" FontSize="12"
                                                               TextWrapping="Wrap" MaxWidth="500"
                                                               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </controls1:SettingsExpanderItem>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
