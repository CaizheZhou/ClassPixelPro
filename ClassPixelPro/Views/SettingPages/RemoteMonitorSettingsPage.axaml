<controls:SettingsPageBase x:Class="ClassPixelPro.Views.SettingPages.RemoteMonitorSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassPixelPro.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassPixelPro.Core.Abstractions.Controls;assembly=ClassPixelPro.Core"
      xmlns:controls1="clr-namespace:ClassPixelPro.Core.Controls;assembly=ClassPixelPro.Core"
      xmlns:ci="http://classpixelpro.tech/schemas/xaml/core"
      xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      mc:Ignorable="d"
      Design.Width="960" Design.Height="500"
      d:DataContext="{d:DesignInstance local:RemoteMonitorSettingsPage}"
      Loaded="RemoteMonitorSettingsPage_OnLoaded"
      Unloaded="RemoteMonitorSettingsPage_OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <controls1:IconText Glyph="&#xE8B6;" Text="远程监控" Margin="0 0 0 4" />

            <!-- 功能说明横幅 -->
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Padding="16 12"
                    CornerRadius="8"
                    Margin="0 0 0 8">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ci:FluentIcon Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="远程监控允许班主任通过公网查看摄像头画面、截取屏幕并传话播放。"
                                   TextWrapping="Wrap" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="启用后将启动本地 HTTP 服务器并建立 Cloudflare Tunnel，请确保网络通畅。关闭后所有隧道连接立即断开。"
                               TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="20 0 0 0" />
                </StackPanel>
            </Border>

            <!-- 监控功能开关 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE8B6;}"
                                        Header="启用远程监控"
                                        Description="启动内嵌 HTTP 服务器与 Cloudflare Tunnel，将本机暴露到公网供班主任远程访问。"
                                        IsExpanded="True">
                <controls3:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsRemoteMonitorEnabled, Mode=TwoWay}"
                                  IsCheckedChanged="ToggleRemoteMonitor_OnIsCheckedChanged"
                                  IsEnabled="{Binding !ViewModel.IsBusy}" />
                </controls3:SettingsExpander.Footer>
                <!-- 监控指示器开关 -->
                <controls3:SettingsExpanderItem Content="显示监控指示器"
                                                Description="在主界面左上角显示置顶的摄像头图标与闪烁红点，提醒当前正在被远程监控。">
                    <controls3:SettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsMonitorIndicatorEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding ViewModel.SettingsService.Settings.IsRemoteMonitorEnabled}" />
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            <!-- 运行状态 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE7B3;}"
                                        Header="运行状态"
                                        IsExpanded="True"
                                        IsVisible="{Binding ViewModel.SettingsService.Settings.IsRemoteMonitorEnabled}">
                <controls3:SettingsExpanderItem Content="监控服务">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     IsVisible="{Binding ViewModel.IsMonitoring}">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#22C55E" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     IsVisible="{Binding !ViewModel.IsMonitoring}">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#94A3B8" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="运行中" VerticalAlignment="Center"
                                       IsVisible="{Binding ViewModel.IsMonitoring}" />
                            <TextBlock Text="已停止" VerticalAlignment="Center"
                                       IsVisible="{Binding !ViewModel.IsMonitoring}" />
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>

                <!-- cloudflared 状态 -->
                <controls3:SettingsExpanderItem Content="cloudflared">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     IsVisible="{Binding ViewModel.IsCloudflaredReady}">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#22C55E" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                     IsVisible="{Binding !ViewModel.IsCloudflaredReady}">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#F59E0B" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding ViewModel.CloudflaredStatus}" VerticalAlignment="Center" />
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>

                <!-- Tunnel URL -->
                <controls3:SettingsExpanderItem Content="隧道 URL"
                                                Description="班主任通过此 URL 访问远程监控接口。">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ViewModel.TunnelUrl}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       IsVisible="{Binding !!ViewModel.TunnelUrl.Length}" />
                            <TextBlock Text="等待隧道就绪…"
                                       VerticalAlignment="Center"
                                       Opacity="0.6"
                                       IsVisible="{Binding !ViewModel.TunnelUrl.Length}" />
                            <Button Theme="{StaticResource TransparentButton}"
                                    Classes="accent"
                                    Content="{ci:FluentIcon &#xE71B;}"
                                    ToolTip.Tip="复制 URL"
                                    Click="ButtonCopyTunnelUrl_OnClick"
                                    IsVisible="{Binding !!ViewModel.TunnelUrl.Length}"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>

                <!-- 访问 Token -->
                <controls3:SettingsExpanderItem Content="访问 Token"
                                                Description="所有远程请求需携带此 Bearer Token。">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding ViewModel.RemoteMonitorService.Token, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       Opacity="0.7" />
                            <Button Theme="{StaticResource TransparentButton}"
                                    Content="{ci:FluentIcon &#xE71B;}"
                                    ToolTip.Tip="复制 Token"
                                    Click="ButtonCopyToken_OnClick"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            <!-- 摄像头选择 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE8B6;}"
                                        Header="摄像头"
                                        Description="选择远程监控使用的摄像头设备。"
                                        IsVisible="{Binding ViewModel.SettingsService.Settings.IsRemoteMonitorEnabled}">
                <controls3:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{Binding ViewModel.AvailableCameras}"
                                  SelectedItem="{Binding ViewModel.SelectedCamera, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Name}"
                                  MinWidth="160"
                                  IsEnabled="{Binding ViewModel.IsCameraCaptureSupported}" />
                        <Button Theme="{StaticResource TransparentButton}"
                                Content="{ci:FluentIcon &#xE72C;}"
                                ToolTip.Tip="刷新摄像头列表"
                                Click="ButtonRefreshCameras_OnClick"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </controls3:SettingsExpander.Footer>
                <controls3:SettingsExpanderItem Content="截屏与摄像头能力"
                                                IsClickEnabled="False">
                    <controls3:SettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="截屏：" VerticalAlignment="Center" />
                                <TextBlock Text="可用" VerticalAlignment="Center"
                                           Foreground="#22C55E"
                                           IsVisible="{Binding ViewModel.IsScreenCaptureSupported}" />
                                <TextBlock Text="不可用" VerticalAlignment="Center"
                                           Foreground="#F59E0B"
                                           IsVisible="{Binding !ViewModel.IsScreenCaptureSupported}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="摄像头：" VerticalAlignment="Center" />
                                <TextBlock Text="可用" VerticalAlignment="Center"
                                           Foreground="#22C55E"
                                           IsVisible="{Binding ViewModel.IsCameraCaptureSupported}" />
                                <TextBlock Text="不可用" VerticalAlignment="Center"
                                           Foreground="#F59E0B"
                                           IsVisible="{Binding !ViewModel.IsCameraCaptureSupported}" />
                            </StackPanel>
                        </StackPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>

            <!-- 诊断操作 -->
            <controls3:SettingsExpander IconSource="{ci:FluentIconSource &#xE7D4;}"
                                        Header="诊断"
                                        IsVisible="{Binding ViewModel.SettingsService.Settings.IsRemoteMonitorEnabled}">
                <controls3:SettingsExpanderItem Content="测试截屏"
                                                Description="采集一帧屏幕并编码为 JPEG，用于验证截屏功能是否正常。"
                                                IsClickEnabled="True"
                                                Click="ButtonTestScreenshot_OnClick" />
            </controls3:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
