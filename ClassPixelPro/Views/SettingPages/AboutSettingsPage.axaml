<controls:SettingsPageBase x:Class="ClassPixelPro.Views.SettingPages.AboutSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="using:ClassPixelPro.Views.SettingPages"
      xmlns:controls="using:ClassPixelPro.Core.Abstractions.Controls"
      xmlns:ci="using:ClassPixelPro"
      xmlns:controls1="using:ClassPixelPro.Core.Controls"
      xmlns:models="using:ClassPixelPro.Models"
      xmlns:commands="http://classpixelpro.tech/schemas/xaml/core"
      xmlns:controls2="clr-namespace:ClassPixelPro.Controls"
      xmlns:ci2="http://classpixelpro.tech/schemas/xaml/core"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
      xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
      xmlns:helpers="clr-namespace:ClassPixelPro.Core.Helpers;assembly=ClassPixelPro.Core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:AboutSettingsPage}">
    <controls:SettingsPageBase.Resources>
        <Grid x:Key="DiagnosticInfoDialog" Margin="16" Height="400" Width="550" MaxHeight="{Binding Height}"
              RowDefinitions="Auto,*,Auto">
            <TextBox Grid.Row="1" Margin="0 12 0 0"
                     Padding="8" Text="{Binding ViewModel.DiagnosticInfo, Mode=OneWay}" IsReadOnly="True"
                     VerticalContentAlignment="Top"
                     FontFamily="Consolas" />
        </Grid>

    </controls:SettingsPageBase.Resources>
    <controls1:StickyScrollViewer CollapsedHeight="58">
        <controls1:StickyScrollViewer.HeaderContent>
            <Grid>
                <Panel MaxHeight="300" 
                       Opacity="{Binding $self.(ci2:StickyScrollViewer.HeaderFadingOpacity)}"
                       Background="Transparent">
                    <Panel.OpacityMask>
                        <LinearGradientBrush StartPoint="0%, 0%"
                                             EndPoint="0%, 100%">
                            <GradientStop Color="#ffffffff" Offset="0.0"/>
                            <GradientStop Color="#ffffffff" Offset="0.75"/>
                            <GradientStop Color="#00ffffff" Offset="0.92"/>
                        </LinearGradientBrush>
                    </Panel.OpacityMask>
                    <Border Background="#0d1111" />
                    <Panel MaxWidth="{StaticResource SettingsContainerWidth}">
                        <Panel.Styles>
                            <Style Selector="Panel">
                                <Style.Animations>
                                    <Animation Delay="0:0:0.25" Duration="0:0:0.2"
                                               FillMode="Both" Easing="0,0 0,1">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="Opacity" Value="0.0"/>
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="Opacity" Value="1.0"/>
                                        </KeyFrame>
                                    </Animation> 
                                </Style.Animations>
                            </Style>
                        </Panel.Styles>
                        <Border Width="{Binding $self.Bounds.Height}"
                                HorizontalAlignment="Left"
                                Margin="-150 -100 0 0">
                            <Border.Background>
                                <RadialGradientBrush Center="50%, 50%">
                                    <GradientStop Offset="0.2" Color="#ff0c0e1f"/>
                                    <GradientStop Offset="1" Color="#ff0d1111"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Width="{Binding $self.Bounds.Height}"
                                HorizontalAlignment="Right"
                                Margin="0 0 100 -50">
                            <Border.Background>
                                <RadialGradientBrush Center="50%, 50%">
                                    <GradientStop Offset="0.2" Color="#ff0c0e1f"/>
                                    <GradientStop Offset="1" Color="#ff0d1111"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                    </Panel>
                    <Image Source="/Assets/BannerMain_App2.png" Stretch="Uniform" 
                           HorizontalAlignment="Center"
                           PointerPressed="DebugBorder_OnPointerPressed"
                           MaxWidth="{StaticResource SettingsContainerWidth}"
                           VerticalAlignment="Top">
                        
                    </Image>
                </Panel>
                <Border Margin="12 16 18 0"
                        MaxWidth="{StaticResource SettingsContainerWidth}">
                    <TextBlock FontWeight="Normal"
                               Text="关于 ClassPixelPro"
                               VerticalAlignment="Bottom"
                               Theme="{StaticResource TitleTextBlockStyle}"
                               Margin="0 8"/>
                </Border>
            </Grid>
        </controls1:StickyScrollViewer.HeaderContent>
        <StackPanel Classes="settings-container ">
            <controls3:SettingsExpander Header="ClassPixelPro"
                                        IsExpanded="True">
                <controls3:SettingsExpander.Footer>
                    <TextBlock Text="{x:Static local:AboutSettingsPage.DisplayVersion}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </controls3:SettingsExpander.Footer>
                <controls3:SettingsExpander.IconSource>
                    <controls3:ImageIconSource Source="/Assets/AppLogo.png"/>
                </controls3:SettingsExpander.IconSource>
                <controls3:SettingsExpanderItem Description="感谢您使用 ClassPixelPro。">
                    <controls3:SettingsExpanderItem.Footer>
                        <WrapPanel Classes="animated-resize">
                            <WrapPanel.Styles>
                                <Style Selector="HyperlinkButton">
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </WrapPanel.Styles>
                            <HyperlinkButton Click="ButtonPrivacy_OnClick"
                                             CommandParameter="https://class.imzcz.cn/#/docs">
                                <TextBlock Text="隐私政策"/>
                            </HyperlinkButton>
                        </WrapPanel>
                    </controls3:SettingsExpanderItem.Footer>
                    <TextBlock Background="Transparent" >
                        <Run Text="Copyright (c) 2023-"/><Run Text="{Binding Year, Source={x:Static system:DateTime.Now}, Mode=OneWay}" /> ClassPixelPro
                    </TextBlock>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="常用链接">
                    <controls3:SettingsExpanderItem.Footer>
                        <WrapPanel Classes="animated-resize">
                            <WrapPanel.Styles>
                                <Style Selector="HyperlinkButton">
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="Margin" Value="2"/>
                                </Style>
                            </WrapPanel.Styles>
                            <HyperlinkButton Click="UriNavigationCommands_OnClick"
                                             CommandParameter="https://class.imzcz.cn/#/docs">
                                <TextBlock Text="帮助文档"/>
                            </HyperlinkButton>
                            <HyperlinkButton Click="UriNavigationCommands_OnClick"
                                             CommandParameter="https://github.com/CaizheZhou/ClassPixelPro">
                                <TextBlock Text="开源仓库"/>
                            </HyperlinkButton>
                            <HyperlinkButton Click="UriNavigationCommands_OnClick"
                                             CommandParameter="https://github.com/ClassIsland/ClassIsland">
                                <TextBlock Text="原项目 ClassIsland"/>
                            </HyperlinkButton>
                        </WrapPanel>
                    </controls3:SettingsExpanderItem.Footer>
                </controls3:SettingsExpanderItem>
                <controls3:SettingsExpanderItem Content="开源信息"
                                                Description="ClassPixelPro 是基于 ClassIsland 二次开发的课堂信息显示工具，源码全部公开，遵循 GPL-3.0 协议开源。"/>
                <controls3:SettingsExpanderItem Content="来源与仓库"
                                                Description="原项目：ClassIsland（作者 HelloWRC 及社区贡献者）；上游仓库 github.com/ClassIsland/ClassIsland，上游官网 classisland.tech；本项目仓库 github.com/CaizheZhou/ClassPixelPro，发布仓库 github.com/CaizheZhou/ClassPixelPro-Releases；项目官网 class.imzcz.cn，服务状态 status.imzcz.cn。"/>
                <controls3:SettingsExpanderItem Content="开源协议"
                                                Description="GPL-3.0（本程序与上游 ClassIsland 均遵循）。完整源代码可通过上方仓库获取；依照 GPL-3.0 第 15/16 条，本程序不提供任何担保。"/>
                <controls3:SettingsExpanderItem Content="插件来源"
                                                Description="插件市场聚合 ClassIsland 社区插件与本项目收录的插件，各插件的版权归其作者所有，安装使用请遵循各插件仓库标注的许可协议。"/>

            </controls3:SettingsExpander>

            <controls3:SettingsExpander Header="遇到问题？" IconSource="{commands:FluentIconSource &#xE3F6;}"
                                        IsExpanded="True">
                <controls3:SettingsExpanderItem 
                    Click="ButtonDiagnosticInfo_OnClick"
                    Content="查看诊断信息"
                    IsClickEnabled="True"/>
            </controls3:SettingsExpander>

            <controls3:SettingsExpander Header="寻求帮助" IconSource="{commands:FluentIconSource &#xE11F;}"
                                        IsExpanded="False"
                                        IsVisible="{Binding ViewModel.ManagementService.HelpInfo.HasContent}">
                <controls3:SettingsExpanderItem>
                    <StackPanel Margin="0 4">
                        <!-- Markdown 帮助信息（type='md' 时展示） -->
                        <mdxaml:MarkdownScrollViewer
                            IsVisible="{Binding ViewModel.ManagementService.HelpInfo.HasMarkdownContent}"
                            Engine="{x:Static helpers:MarkdownConvertHelper.Engine}"
                            Markdown="{Binding ViewModel.ManagementService.HelpInfo.MarkdownContent}"
                            Margin="0 0 0 8">
                            <mdxaml:MarkdownScrollViewer.Styles>
                                <Style Selector="mdxaml|MarkdownScrollViewer /template/ ScrollViewer">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </mdxaml:MarkdownScrollViewer.Styles>
                        </mdxaml:MarkdownScrollViewer>
                        <!-- 结构化联系人信息（type='struct' 时展示） -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 8 0" IsVisible="{Binding ViewModel.ManagementService.HelpInfo.HasContactName}">
                            <TextBlock Text="技术联系人：" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ViewModel.ManagementService.HelpInfo.ContactName}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 8 0" IsVisible="{Binding ViewModel.ManagementService.HelpInfo.HasContactMethod}">
                            <TextBlock Text="联系方式：" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ViewModel.ManagementService.HelpInfo.ContactMethod}"/>
                            <TextBlock Text="：" />
                            <TextBlock Text="{Binding ViewModel.ManagementService.HelpInfo.ContactId}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 8 0" IsVisible="{Binding ViewModel.ManagementService.HelpInfo.HasNotes}">
                            <TextBlock Text="说明：" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ViewModel.ManagementService.HelpInfo.Notes}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>
            
            <controls3:SettingsExpander Header="回声洞" IconSource="{commands:FluentIconSource &#xE55F;}">
                <controls3:SettingsExpanderItem 
                    IsClickEnabled="True"
                    Click="Sayings_OnMouseLeftButtonDown">
                    <StackPanel>
                        <controls2:TypingControl
                                 Text="{Binding ViewModel.Sayings, Mode=OneWay}"
                                 IsBusy="{Binding ViewModel.IsSayingBusy, Mode=OneWayToSource}"/>
                    </StackPanel>
                </controls3:SettingsExpanderItem>
            </controls3:SettingsExpander>
        </StackPanel>
    </controls1:StickyScrollViewer>
</controls:SettingsPageBase>
