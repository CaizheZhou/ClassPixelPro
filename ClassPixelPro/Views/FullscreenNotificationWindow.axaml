<Window x:Class="ClassPixelPro.Views.FullscreenNotificationWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassPixelPro.Views"
        mc:Ignorable="d"
        Title="全屏通知"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F0000000"
        Closing="OnClosing"
        PointerPressed="OnDismiss"
        KeyDown="OnKeyDown">
    <Grid Background="#F0000000">
        <Border Margin="64"
                Padding="56"
                CornerRadius="28"
                Background="#FF0B0F14"
                BorderBrush="#FF2A3340"
                BorderThickness="2">
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontWeight="Bold"
                           Foreground="White" />
            </Viewbox>
        </Border>
        <TextBlock Text="点击任意位置或按 Esc 关闭"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,28"
                   FontSize="18"
                   Foreground="#99FFFFFF" />
    </Grid>
</Window>
