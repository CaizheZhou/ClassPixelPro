<ci:MyWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ci="http://classpixelpro.tech/schemas/xaml/core"
        xmlns:local="clr-namespace:ClassPixelPro.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:FaceEnrollPromptWindow}"
        x:Class="ClassPixelPro.Views.FaceEnrollPromptWindow"
        Title="这张照片是谁？"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowAsDialog="True"
        CanResize="False">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <!-- 标题与提示 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="指定这张照片里的同学" Theme="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{Binding Vm.HintText}" TextWrapping="Wrap" Classes="l-instructive" />
        </StackPanel>

        <!-- 照片预览 + 人脸选择 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0 12 0 0">
            <Border Grid.Column="0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8" Margin="0 0 8 0">
                <Panel>
                    <Image Source="{Binding Vm.PreviewImage}" Stretch="Uniform" MaxHeight="240"
                           HorizontalAlignment="Center" />
                    <TextBlock Text="没有可显示的预览"
                               IsVisible="{Binding Vm.PreviewImage, Converter={x:Static ObjectConverters.IsNull}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Panel>
            </Border>

            <!-- 检测到的脸：一张一行，点一下选中 -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8" Margin="8 0 0 0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="检测到的脸" FontWeight="SemiBold" Margin="0 0 0 8" />
                    <ListBox x:Name="FaceList"
                             ItemsSource="{Binding Vm.FaceItems}"
                             Background="Transparent"
                             SelectionChanged="FaceList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8 6" CornerRadius="4">
                                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 归属选择 -->
        <StackPanel Grid.Row="2" Spacing="10" Margin="0 14 0 0">
            <TextBlock Text="这张脸归谁？" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="归属同学" VerticalAlignment="Center" Width="72" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Vm.CandidateItems}"
                          SelectedItem="{Binding Vm.SelectedOwner, Mode=TwoWay}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <TextBox Text="{Binding Vm.NewName, Mode=TwoWay}"
                     Watermark="新同学姓名（选了「新建同学…」时填写）"
                     IsVisible="{Binding Vm.SelectedStudent, Converter={x:Static ObjectConverters.IsNull}}" />
            <TextBlock Text="选「新建同学…」会把这位同学加进花名册，之后可以在花名册里改名、补录照片。"
                       TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
        </StackPanel>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 16 0 0">
            <Button Content="跳过这张" Click="ButtonSkip_OnClick" />
            <Button Content="取消整批" Click="ButtonCancel_OnClick" />
            <Button Content="确定" Classes="accent" Click="ButtonConfirm_OnClick"
                    IsEnabled="{Binding Vm.CanConfirm}" />
        </StackPanel>
    </Grid>
</ci:MyWindow>
